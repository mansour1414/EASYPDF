<?xml version="1.0" encoding="UTF-8"?>
<!--
  EasyPDF — sitemap.xml (Sept 2026)

  Lists only the indexable pages from src/lib/routes.ts's INDEXABLE_PAGES
  list. Account-specific and admin pages are intentionally excluded here
  and disallowed in robots.txt.

  This file is static (not generated at build/request time). If a new
  public page is added to INDEXABLE_PAGES in src/lib/routes.ts, add the
  matching <url> entry here too — the two lists are meant to stay in sync
  but are not automatically linked.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">

  <url>
    <loc>https://easypdf-eight.vercel.app/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>

  <url>
    <loc>https://easypdf-eight.vercel.app/tools</loc>
    <changefreq>weekly</changefreq>
    <priority>0.9</priority>
  </url>

  <url>
